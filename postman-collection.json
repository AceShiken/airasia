{
  "info": {
    "name": "Currency Conversion API",
    "description": "API collection for testing Currency Conversion endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Convert USD to EUR",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/convert?from=USD&to=EUR&amount=100",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["convert"],
          "query": [
            {"key": "from", "value": "USD"},
            {"key": "to", "value": "EUR"},
            {"key": "amount", "value": "100"}
          ]
        }
      }
    },
